{
  "name": "umactually",
  "version": "0.8.0",
  "description": "Provider-agnostic PR review action with redaction and SonarQube import.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "UmActually contributors",
  "homepage": "https://github.com/JosiahSiegel/umactually#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JosiahSiegel/umactually.git"
  },
  "bugs": {
    "url": "https://github.com/JosiahSiegel/umactually/issues"
  },
  "keywords": [
    "github-action",
    "pr-review",
    "code-review",
    "ai-review",
    "anthropic",
    "openai",
    "copilot",
    "redaction",
    "secrets-scanning",
    "sonarqube"
  ],
  "bin": {
    "umactually": "bin/umactually.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "scripts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest run --project unit --coverage --coverage.thresholds.statements=78 --coverage.thresholds.branches=70 --coverage.thresholds.functions=80 --coverage.thresholds.lines=78",
    "test:unit": "vitest --project unit",
    "test:scenario": "vitest --project scenario",
    "test:e2e": "vitest --run --project e2e",
    "test:post-release": "node test/post-release/run-e2e.mjs",
    "test:review-eval": "node scripts/run-review-eval.mjs",
    "test:config": "vitest --run --project unit test/unit/config-extended.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "build": "ncc build src/cli.ts -o dist && node scripts/post-bundle.mjs",
    "build:binary": "node scripts/build-sea.mjs",
    "bundle": "npm run build",
    "render-docs": "node scripts/render-versions.mjs",
    "render-docs:check": "node scripts/render-versions.mjs --check",
    "check:version-alignment": "node scripts/check-version-alignment.mjs",
    "check:dist-freshness": "node scripts/check-dist-freshness.mjs",
    "prepublishOnly": "npm run typecheck && npm test -- --run && npm run test:review-eval && npm run bundle && npm run render-docs && npm run check:version-alignment && npm run check:dist-freshness",
    "build:sea": "node scripts/build-sea.mjs",
    "build:sea:all": "node scripts/build-sea.mjs all"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tsdown/exe": "0.22.13",
    "@types/node": "^24.0.0",
    "@types/yaml": "^1.9.6",
    "@vercel/ncc": "0.38.4",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.5",
    "tar-stream": "3.2.0",
    "tsdown": "0.22.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
