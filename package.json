{
  "name": "umactually",
  "version": "0.1.0",
  "description": "Provider-agnostic PR review action with redaction and SonarQube import.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "UmActually contributors",
  "homepage": "https://github.com/JosiahSiegel/umactually#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosiahSiegel/umactually.git"
  },
  "bugs": {
    "url": "https://github.com/JosiahSiegel/umactually/issues"
  },
  "keywords": [
    "github-action",
    "pr-review",
    "code-review",
    "ai-review",
    "anthropic",
    "openai",
    "copilot",
    "redaction",
    "secrets-scanning",
    "sonarqube"
  ],
  "main": "dist/index.js",
  "bin": {
    "umactually-pr-review": "bin/umactually-pr-review.mjs"
  },
  "files": [
    "dist",
    "bin",
    "action.yml",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:scenario": "vitest --project scenario",
    "test:config": "vitest --run --project unit test/unit/config-extended.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "ncc build src/index.ts -o dist && ncc build src/cli.ts -o dist-tmp && node scripts/post-bundle.mjs",
    "bundle": "npm run build",
    "check:dist-freshness": "node scripts/check-dist-freshness.mjs",
    "view:summary-layouts": "node scripts/view-summary-layouts.mjs",
    "clean:summary-layouts": "node scripts/clean-viewer.mjs",
    "prepublishOnly": "npm run typecheck && npm test -- --run && npm run bundle && npm run check:dist-freshness"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "0.38.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}