# UmActually local development environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored — never
# commit secrets. The canonical env-var surface is in
# src/util/env-keys.ts; this file lists only the keys a contributor
# needs for local dry-runs against a real review API and Azure DevOps.

# ---------------------------------------------------------------------------
# Review API
# ---------------------------------------------------------------------------
# URL and key for the review provider. The action's interpretation of
# `UMACTUALLY_API_URL` depends on `UMACTUALLY_PROVIDER` (and the dispatcher
# auto-discovers across protocols on dual-protocol gateways — see
# docs/providers.md).
#
# Common valid setups:
#   * Anthropic-protocol gateway under path prefix (MiniMax):
#     UMACTUALLY_API_URL=https://api.minimax.io/anthropic
#     UMACTUALLY_PROVIDER=anthropic
#     UMACTUALLY_API_KEY=<MiniMax-key>
#       → POSTs to https://api.minimax.io/anthropic/v1/messages
#         with x-api-key + anthropic-version headers (no Authorization).
#
#   * OpenAI-protocol gateway under same hostname (MiniMax):
#     UMACTUALLY_API_URL=https://api.minimax.io/v1
#     UMACTUALLY_PROVIDER=openai-compatible
#     UMACTUALLY_API_KEY=<MiniMax-key>
#       → POSTs to https://api.minimax.io/v1/responses with
#         Authorization: Bearer <key>.
#
#   * Vanilla Anthropic API:
#     UMACTUALLY_PROVIDER=anthropic  (URL defaults to https://api.anthropic.com/v1)
#
#   * Vanilla OpenAI / OpenAI-protocol gateway:
#     UMACTUALLY_PROVIDER=openai-compatible
#     UMACTUALLY_API_URL=https://api.openai.com/v1
#
# On dual-protocol gateways the action retries the OTHER protocol at the
# same URL when the named one returns 404. Setting either provider by
# name works — the dispatcher figures out which protocol the URL serves.
# ---------------------------------------------------------------------------

UMACTUALLY_API_URL=
UMACTUALLY_API_KEY=
UMACTUALLY_PROVIDER=openai-compatible
UMACTUALLY_MODEL=auto

# Azure DevOps (optional — only needed for live Azure PR review posting)
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_REPO=
AZURE_DEVOPS_PULL_REQUEST_ID=
AZURE_DEVOPS_TOKEN=

# ---------------------------------------------------------------------------
# Personal Access Tokens (PATs) — for tooling that hits the ADO/GitHub REST
# APIs outside the action's OAuth flow (e.g. an agent inspecting PR state).
# ---------------------------------------------------------------------------
#
# DEVOPS_PAT: Azure DevOps Personal Access Token used by hand-rolled curl
# commands against https://dev.azure.com/{org}/{project}/_apis/... when you
# need to read/write the PR outside the action's own posting pipeline.
# Generate one at https://dev.azure.com/{org}/_usersSettings/tokens with
# scopes: Code (Read & Write), Pull Request Threads (Read & Write),
# Pull Request Status (Read & Write). Required scope varies by use case;
# `Code (Read)` is the minimum for inspecting PR state.
#
# Both DEVOPS_PAT and AZURE_DEVOPS_TOKEN are accepted — DEVOPS_PAT is the
# agent-friendly name, AZURE_DEVOPS_TOKEN is the runtime-side name. They
# can hold the same value or different PATs with different scopes.
#
# To source it in a shell session:
#   set -a && source .env && set +a    # exports all .env keys
#   curl -s -u ":${DEVOPS_PAT}" "https://dev.azure.com/${AZURE_DEVOPS_ORG}/${AZURE_DEVOPS_PROJECT}/_apis/git/pullrequests/${AZURE_DEVOPS_PULL_REQUEST_ID}?api-version=7.1"
#
# ---------------------------------------------------------------------------
DEVOPS_PAT=
# ---------------------------------------------------------------------------
# NPM_TOKEN: npm Granular Access Token used ONLY for the one-time local
# first-publish of a new package name. NOT consumed by the release
# workflow — the `publish-npm` job authenticates via Trusted Publishing
# (OIDC) from GitHub Actions; no NPM_TOKEN secret is stored in repo
# settings. Set this locally only if you need to:
#
#   (a) claim a brand-new package name on npmjs.org (the chicken-and-egg
#       step before a Trusted Publisher binding can be configured); or
#   (b) publish a hotfix from a local terminal when the CI publish path
#       is unavailable (see CONTRIBUTING.md#manual-re-publish-release-engineer).
#
# Generate at https://www.npmjs.com/settings/~/tokens with:
#   - Type: Granular Access Token
#   - Name: e.g. "umactually-local-publish"
#   - Expiration: 90 days (or whatever fits the rotation cadence)
#   - Packages and scopes: "umactually" (single package) or "All packages"
#   - Permissions: "Read and write"
#   - Bypass 2FA: ON (REQUIRED at token-creation time; see the note below)
#
# IMPORTANT (as of July 2026): npm no longer honors `bypass_2fa: true`
# for direct publishing at publish time — every `npm publish` for an
# account with 2FA enabled requires an interactive WebAuth challenge
# (passkey, security key, or Touch ID) regardless of the token's
# `bypass_2fa` flag. The `bypass_2fa: true` setting is still required
# when CREATING the token (it's a creation-time policy gate) but does
# not bypass the runtime 2FA challenge. The local first publish for
# v0.6.19 used the browser's "Don't challenge requests from this IP
# for 5 minutes" option to skip the ceremony within the trust window.
# See CONTRIBUTING.md#publish-authentication-in-2026-webauth--device-flow
# for the full mechanism, including the non-TTY helper script
# (`scripts/publish-with-webauth.mjs`).
#
# CAUTION: a `~/.npmrc` line like
# `//registry.npmjs.org/:_authToken=npm_...` overrides this env var
# (npm config layering: user-level `.npmrc` wins over env vars).
# Audit with `npm config ls -l --location=user` if `npm publish` uses
# the wrong account.
# ---------------------------------------------------------------------------
NPM_TOKEN=
