{
  "name": "umactually-task",
  "version": "0.1.0",
  "private": true,
  "description": "Azure DevOps Build/Release task that wraps the UmActually CLI. IN DEVELOPMENT — not yet published to the Visual Studio Marketplace.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -f index.js redact-secrets.js *.js.map",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/redact-secrets.test.cjs"
  },
  "dependencies": {
    "azure-pipelines-task-lib": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
